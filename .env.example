# Copy to .env and fill in. .env is git-ignored.

# ── Gemini Live / Google AI (required) ───────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Blender socket (client -> local Blender addon) ───────
BLENDER_HOST=localhost
BLENDER_PORT=9876

# ── Optional: Google image reference refinement ───────────
# Create a Programmable Search Engine and put its ID here to enable:
#   /refs part
#   /refs object
# The demo opens a thumbnail chooser unless launched with --no-reference-popup.
# This is a Google Cloud API key with Custom Search JSON API enabled.
# It is separate from GOOGLE_API_KEY, which is used for Gemini.
# GOOGLE_SEARCH_API_KEY=your_google_cloud_custom_search_api_key
# GOOGLE_CSE_ID=your_programmable_search_engine_id
# FORGE_REFERENCE_VISION_MODEL=gemini-2.5-flash

# ── Optional: automatic voice input ───────────────────────
# Uses GOOGLE_API_KEY / GEMINI_API_KEY to transcribe and polish voice commands.
# Spoken build prompts use direct Text2Blender by default for the smooth live demo.
# Gemini automatically improves short voice/typed build prompts before generation.
# Launch with --voice-adk only when you want to test the optional ADK route.
# Gemini Live voice output starts on by default; launch with --no-speak-info for quiet rooms.
# Automatic voice input starts on by default and stops recording after a short silence.
# Automatic voice commands require "Hey Travis" first by default.
# Change it with --wake-phrase "Hey Forge", or disable it with --no-wake-phrase.
# Use /mic off at runtime or launch with --no-auto-voice-input to pause it.
# FORGE_VOICE_INPUT_MODEL=gemini-2.5-flash
# FORGE_PROMPT_IMPROVER_MODEL=gemini-2.5-flash

# ── Forge server (client -> orchestrator) ────────────────
# Local dev default; point at Cloud Run later.
FORGE_WS_URL=ws://127.0.0.1:8000/ws

# ── Optional: path to the Blender executable for auto-launch (Step 4) ──
# macOS default shown; leave blank to attach to an already-running Blender.
BLENDER_APP_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# ── Phase 5 / cloud only (Step 14) ───────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-credentials.json
# FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
